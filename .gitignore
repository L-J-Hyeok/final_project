# Taste Skill: exclude forbidden executable scripts and heavy demo assets (~38MB),
# while keeping read-only design docs (SKILL.md, references/, library/) and skills-lock.json
.agents/skills/design-taste-frontend/scripts/
.agents/skills/design-taste-frontend/assets/
.agents/skills/design-taste-frontend/**/*.mjs
.agents/skills/design-taste-frontend/**/*.js

