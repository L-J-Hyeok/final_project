# 비밀값은 실제 .env에만 설정하세요. Git에 추가하지 마세요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=final_project
DB_USER=final_project_app
DB_PASSWORD=
# 32바이트 이상 무작위 값. 운영에서는 안전한 환경 변수로 주입.
SESSION_SECRET=
# 실제 브라우저의 origin과 정확히 일치. 로컬 Vue 프록시 사용 시 해당 origin으로 변경.
APP_ORIGIN=http://localhost:3000
# 신뢰할 로컬 역방향 프록시를 명시적으로 사용하는 경우에만 true.
TRUST_PROXY_LOOPBACK=false
