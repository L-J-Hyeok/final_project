# 비밀값은 실제 .env에만 설정하세요. Git에 추가하지 마세요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=final_project
DB_USER=final_project_app
DB_PASSWORD=
# 32바이트 이상 무작위 값. 운영에서는 안전한 환경 변수로 주입.
SESSION_SECRET=
# 실제 브라우저의 origin과 정확히 일치. 로컬 Vue 프록시 사용 시 해당 origin으로 변경.
APP_ORIGIN=http://localhost:3000
# 신뢰할 로컬 역방향 프록시를 명시적으로 사용하는 경우에만 true.
TRUST_PROXY_LOOPBACK=false
# AI 공급자 설정: gemini(기본 주력) 또는 mock(자동 테스트·오프라인 개발용)
AI_PROVIDER=gemini
# Google AI Studio에서 발급한 Gemini API 키 (절대 Git이나 로그에 노출하지 마세요)
GEMINI_API_KEY=
# 사용할 Gemini 모델명 (기본값: gemini-3.5-flash-lite, 품질 비교 선택 모델: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
# 개발 환경 전용 참고·출고가 폴백 허용 여부 (기본값: false, NODE_ENV=development 에서도 명시적 true일 때만 동작)
ALLOW_DEVELOPMENT_PRICES=false
# 업그레이드 안내 팝업 '나중에 보기' 억제 기간(일, 기본값: 30)
UPGRADE_SNOOZE_DAYS=30
